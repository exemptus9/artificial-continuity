{
  "id": "./",
  "name": "Artificial Continuity",
  "short_name": "Continuity",
  "description": "Capture on your phone, review on your desktop, resume in your own app. Local-first; explicit transfers, no automatic sync.",
  "start_url": "./#now",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101719",
  "theme_color": "#101719",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick capture",
      "url": "./#capture"
    },
    {
      "name": "One-box intake",
      "url": "./#fast-intake"
    },
    {
      "name": "Resume work",
      "url": "./#now"
    },
    {
      "name": "Incoming shares",
      "url": "./#incoming"
    }
  ],
  "orientation": "any",
  "categories": [
    "productivity",
    "utilities"
  ],
  "share_target": {
    "action": "./share-in",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/plain",
            "text/markdown",
            ".txt",
            ".md"
          ]
        }
      ]
    }
  }
}
