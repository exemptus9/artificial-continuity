FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TOTAL_RECALL_ARCHIVE_HOME=/data
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libqrencode4 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-cloud.txt .
RUN pip install --no-cache-dir -r requirements-cloud.txt
COPY recall_archive.py recall_desk.py recall_web.py cloud_host.py cloud_media.py archive_backup.py ./
COPY web ./web
CMD ["python", "cloud_host.py"]
